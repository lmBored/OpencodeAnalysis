rs.noreply.github.com","Date":"2026-04-16T18:29:57+00:00","Message":"chore: generate"},{"Sha":"143817d44e1ededeccbaff3e61690dfea4fe4109","Login":"rekram1-node","IsBot":false,"AuthorName":"Aiden Cline","AuthorEmail":"63023139\u002Brekram1-node@users.noreply.github.com","Date":"2026-04-16T18:28:20+00:00","Message":"chore: bump ai sdk deps for opus 4.7 (#22869)"},{"Sha":"c60862fc9e0a3378fe7be7c5079545c0d5c8d405","Login":"trbutler4","IsBot":false,"AuthorName":"Thomas Butler","AuthorEmail":"58192340\u002Btrbutler4@users.noreply.github.com","Date":"2026-04-16T18:21:04+00:00","Message":"fix: add missing glob dependency  (#22851)"},{"Sha":"bee5f919fc5ae915aad0a4b5138e1e7f8274b9de","Login":"thdxr","IsBot":false,"AuthorName":"Dax Raad","AuthorEmail":"d@ironbay.co","Date":"2026-04-16T17:32:22+00:00","Message":"core: reorganize ConfigPaths module export for cleaner dependency management"},{"Sha":"cefa7f04c66fce1fb586736222a2d6b8a5609ded","Login":"thdxr","IsBot":false,"AuthorName":"Dax Raad","AuthorEmail":"d@ironbay.co","Date":"2026-04-16T17:32:22+00:00","Message":"core: reorganize ConfigPaths module export for cleaner dependency management"},{"Sha":"03e20e6ac125b6a792c567451c2f904c6ed6941c","Login":"thdxr","IsBot":false,"AuthorName":"Dax Raad","AuthorEmail":"d@ironbay.co","Date":"2026-04-16T17:29:00+00:00","Message":"core: modularize config parsing to improve maintainability\n\nExtract error handling, parsing logic, and variable substitution into dedicated\nmodules. This reduces duplication between tui.json and opencode.json parsing\nand makes the config system easier to extend for future config formats."},{"Sha":"c5deeee8c7b2e5b3927d28958d2ceb9ebddeb256","Login":"rekram1-node","IsBot":false,"AuthorName":"Aiden Cline","AuthorEmail":"63023139\u002Brekram1-node@users.noreply.github.com","Date":"2026-04-16T17:19:01+00:00","Message":"fix: ensure azure has store = true by default (#22764)"},{"Sha":"8b1f0e2d90c03fc5de6077f868af1548485cc466","Login":"thdxr","IsBot":false,"AuthorName":"Dax Raad","AuthorEmail":"d@ironbay.co","Date":"2026-04-16T16:55:40+00:00","Message":"core: add documentation comments to plugin configuration merge logic\n\nAdds explanatory comments to config.ts and plugin.ts clarifying:\n\n- How plugin specs are stored and normalized during config loading\n\n- Why plugin_origins tracks provenance for location-sensitive decisions\n\n- Why path-like specs are resolved early to prevent reinterpretation during merges\n\n- How plugin deduplication works while keeping origin metadata for writes and diagnostics"},{"Sha":"9bf2dfea353135874e2ba5d284e6eb0cd1b9e35d","Login":"thdxr","IsBot":false,"AuthorName":"Dax Raad","AuthorEmail":"d@ironbay.co","Date":"2026-04-16T16:47:09+00:00","Message":"core: refactor config schemas into separate modules for better maintainability"},{"Sha":"33bb847a1dfb5e79b4815813739671a40afa0e51","Login":"thdxr","IsBot":false,"AuthorName":"Dax Raad","AuthorEmail":"d@ironbay.co","Date":"2026-04-16T16:40:16+00:00","Message":"config: refactor"},{"Sha":"bfffc3c2c6349d9199dd1a73260612b5ec2da88d","Login":"thdxr","IsBot":false,"AuthorName":"Dax Raad","AuthorEmail":"d@ironbay.co","Date":"2026-04-16T16:19:43+00:00","Message":"tui: ensure TUI plugins load with proper project context when multiple directories are open\n\nFixes potential plugin resolution issues when switching between projects by wrapping\nplugin loading in Instance.provide(). This ensures each plugin resolves dependencies\nrelative to its correct project directory instead of inheriting context from whatever\ninstance happened to be active.\n\nAlso reorganizes config loading code into focused modules (command.ts, managed.ts,\nplugin.ts) to make the codebase easier to maintain and test."},{"Sha":"b28956f0dbc22d786fab24b2a34fd07fba6d27ec","Login":"jlongster","IsBot":false,"AuthorName":"James Long","AuthorEmail":"longster@gmail.com","Date":"2026-04-16T16:35:37+00:00","Message":"fix(core): better global sync event structure (#22858)"},{"Sha":"d82bc3a421c04e3abbade1